# Copy this file to .env for local development. Never commit .env.

# PostgreSQL used by the Express API (matches docker-compose.yml)
DATABASE_URL=postgresql://ride:ride_dev_only@localhost:5432/ride
PGSSLMODE=disable

# API server
API_PORT=3001
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Public app origin used to build password reset links
APP_ORIGIN=http://localhost:5173

# Optional email delivery for password reset links (Resend)
# In production both values are required for reset emails to be delivered.
RESEND_API_KEY=
RESET_FROM_EMAIL=

# Optional client override. Leave blank to use the Vite /api proxy.
VITE_API_BASE_URL=
